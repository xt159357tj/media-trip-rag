# ===== 通义千问 (DashScope) =====
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-omni-flash

# ===== DeepSeek =====
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===== Tavily (联网搜索) =====
TAVILY_API_KEY=your_tavily_api_key_here

# ===== LangSmith (可观测性) =====
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=Agent_Project

# ===== MinerU PDF 解析模型路径（可选） =====
MINERU_MODEL_DIR=/path/to/your/mineru/PDF-Extract-Kit-1.0

# ===== MCP 外部服务 =====
GAODE_URL=https://mcp.api-inference.modelscope.net/your_gaode_sse_path/sse
T12306_URL=https://mcp.api-inference.modelscope.net/your_12306_sse_path/sse
